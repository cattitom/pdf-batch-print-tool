{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShippingShell",
  "version": "0.1.0",
  "identifier": "com.hanlin.shippingshell",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node -e \"import(require('node:fs').existsSync('scripts/sync-mobile.mjs') ? './scripts/sync-mobile.mjs' : '../scripts/sync-mobile.mjs')\"",
    "beforeDevCommand": "node -e \"import(require('node:fs').existsSync('scripts/sync-mobile.mjs') ? './scripts/sync-mobile.mjs' : '../scripts/sync-mobile.mjs')\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "出货助手",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
