# ---- 构建产物 ----
target/
target-test/
node_modules/
dist/
dist-build/
dist-ssr/
/gen/schemas/

# ---- 运行时数据（日志、SQLite）----
logs/
*.log
*.db
*.db-shm
*.db-wal

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# ---- 本地临时 ----
*.local
.env
.env.*

# ---- Python 缓存（out/generator 用）----
__pycache__/
*.pyc

# ---- OCR 模型（37MB 二进制，按 desktop/models/README.md 单独下载）----
desktop/models/*
!desktop/models/README.md

# ---- WorkBuddy 应用指针（含本机绝对路径，换机器就失效）----
.wbapp_*.genie

# ---- 与本项目无关的生成素材（大肥鱼视频等）----
/out/

# ---- 本机一次性输入数据（拖进来试功能的样例）----
/晚宴包.csv

# ---- 临时截图（oil-ui 调试用）----
/shots/

# ---- kdocs 抓数用的独立浏览器配置（含登录态 cookie，绝不入库）----
/.wps-profile/
/.wps-profile-*/

# ---- 临时脚本/预览 fixture ----
/.tmp/
/.npm-cache/
/oil-ui-work/

# ---- 历史调试脚本（早期查 .xls 用的临时 probe，本地留着就行）----
desktop/core/examples/probe_*.rs
desktop/core/examples/row_probe*.rs
desktop/core/examples/wb_*.rs
desktop/core/examples/waybill_check.rs

# 本地生成的飞书/豆包清单样本
feishu-sample/
